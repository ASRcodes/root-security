<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/historyPage" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:text="@string/history" android:textAppearance="@style/Text.DMM.Title"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="16dp" android:text="@string/history_subtitle" android:textAppearance="@style/Text.DMM.Body"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/historyProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"/>
    <androidx.core.widget.NestedScrollView android:id="@+id/historyState" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="24dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_history" app:tint="@color/info" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/historyStateTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="16dp" android:textAppearance="@style/Text.DMM.Section"/>
        <TextView android:id="@+id/historyStateBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="8dp" android:textAppearance="@style/Text.DMM.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRetryHistory" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry"/>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerHistory" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnMoreHistory" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_load_more" android:visibility="gone"/>
</LinearLayout>
