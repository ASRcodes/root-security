<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/historyDirection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.DMM.Label" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/historyName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.DMM.Section"/>
        <TextView android:id="@+id/historyPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.DMM.Body" android:textIsSelectable="true"/>
        <TextView android:id="@+id/historyTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textAppearance="@style/Text.DMM.Label"/>
        <TextView android:id="@+id/historyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textAppearance="@style/Text.DMM.Body" android:textColor="@color/info"/>
        <TextView android:id="@+id/historyLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.DMM.Body" app:drawableStartCompat="@drawable/ic_location" app:drawableTint="@color/info" android:drawablePadding="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/historyMap" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_map" app:icon="@drawable/ic_location"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/historyVoice" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_play_voice" app:icon="@drawable/ic_play"/>
        <TextView android:id="@+id/historyVoiceExpired" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_voice_expired" android:textAppearance="@style/Text.DMM.Body" android:visibility="gone"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
