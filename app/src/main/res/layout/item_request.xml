<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/tvName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unknown_sender" android:textAppearance="@style/Text.DMM.Section"/>
        <Space android:layout_width="1dp" android:layout_height="4dp"/>
        <TextView android:id="@+id/tvPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/loading" android:textAppearance="@style/Text.DMM.Body"/>
        <Space android:layout_width="1dp" android:layout_height="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAccept" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/accept" app:icon="@drawable/ic_check_circle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDecline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/decline" style="@style/Widget.Material3.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnReport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/report" style="@style/Widget.Material3.Button.TextButton"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
