<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.DMM.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.DMM.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.DMM.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ThemeOverlay.DMM.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_elevated</item>
    </style>
    <style name="Widget.DMM.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/info_soft</item>
    </style>
    <style name="Widget.DMM.Button.Emergency" parent="Widget.DMM.Button">
        <item name="backgroundTint">@color/emergency_button_background</item>
        <item name="android:textColor">@color/emergency_button_foreground</item>
        <item name="iconTint">@color/emergency_button_foreground</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">16sp</item>
        <item name="icon">@drawable/ic_alert_signal</item>
    </style>
    <style name="Widget.DMM.Button.EmergencyTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/emergency_tonal_background</item>
        <item name="android:textColor">@color/emergency_tonal_foreground</item>
        <item name="iconTint">@color/emergency_tonal_foreground</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="iconGravity">textStart</item>
        <item name="icon">@drawable/ic_alert_signal</item>
    </style>
</resources>
