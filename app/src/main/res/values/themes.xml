<resources>
    <style name="Base.Theme.DontMissMOM" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/info</item>
        <item name="colorOnPrimary">@color/on_info</item>
        <item name="colorPrimaryContainer">@color/info_soft</item>
        <item name="colorOnPrimaryContainer">@color/info</item>
        <item name="colorSecondary">@color/info</item>
        <item name="colorSecondaryContainer">@color/info_soft</item>
        <item name="colorOnSecondaryContainer">@color/info</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/control_outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_primary</item>
        <item name="colorErrorContainer">@color/danger_soft</item>
        <item name="colorOnErrorContainer">@color/primary</item>
        <item name="colorSurfaceContainer">@color/surface_elevated</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/background</item>
        <item name="colorSurfaceBright">@color/surface_elevated</item>
        <item name="colorSurfaceDim">@color/background</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.DMM.Button</item>
        <item name="materialCardViewStyle">@style/Widget.DMM.Card</item>
        <item name="textInputStyle">@style/Widget.DMM.Input</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DMM.Dialog</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DMM.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DMM.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DMM.Large</item>
        <item name="motionDurationShort2">150</item>
        <item name="motionDurationMedium2">250</item>
    </style>
    <style name="Theme.DontMissMOM" parent="Base.Theme.DontMissMOM" />
    <style name="Theme.DontMissMOM.AlertFullScreen" parent="Theme.DontMissMOM" />
    <style name="Widget.DMM.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_background</item>
        <item name="android:textColor">@color/button_foreground</item>
        <item name="iconTint">@color/button_foreground</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="Widget.DMM.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">1dp</item>
    </style>
    <style name="Widget.DMM.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="Text.DMM.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="Text.DMM.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Text.DMM.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Text.DMM.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="CircularImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
